PORT=4000
JWT_SECRET=replace-this-with-a-long-random-string

# AI assistant (get a key at https://console.anthropic.com). Leave blank to run the
# built-in basic assistant instead. The key stays on the server - never in the browser.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5

# Extra allowed CORS origins, comma-separated. Only needed if you host the
# frontend separately from this server (e.g. a web deploy on Vercel/Netlify).
# The Capacitor mobile app is already allowed by default - you don't need to
# add anything here just to publish the app.
ALLOWED_ORIGINS=
